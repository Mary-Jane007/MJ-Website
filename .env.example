# Kopieer naar .env.local voor lokaal testen. Op productie (Vercel): Environment Variables.

# Publieke site-URL (zonder slash aan het eind) — gebruik je echte domein zodra live.
# Voorbeeld: https://jouwdomein.com
# Op Vercel wordt VERCEL_URL gebruikt als fallback; voor SEO is een vaste URL het beste.
NEXT_PUBLIC_SITE_URL=

# Contactformulier via Resend — verplicht op productie (anders geeft /api/contact 503).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optioneel: ontvanger; anders SITE.email uit de code
CONTACT_TO_EMAIL=

# Facebook-pagina (geen placeholder gebruiken op live)
NEXT_PUBLIC_FACEBOOK_URL=

# Neon (Postgres)
DATABASE_URL=
# Optioneel: directe DB-verbinding voor migrations/seeding
DIRECT_URL=

# Vercel
# VERCEL_URL wordt automatisch gezet door Vercel.
